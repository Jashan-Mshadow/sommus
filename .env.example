# Copy to .env and fill in. .env is gitignored — never commit it.
ANTHROPIC_API_KEY=

# Gmail: turn on 2-Step Verification, then create an app password at
# https://myaccount.google.com/apppasswords (16 characters, spaces are fine).
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=

# Telegram (optional): message @BotFather, send /newbot, paste the token here.
# Leave TELEGRAM_ALLOWED_IDS empty at first — Sommus prints your chat id when you message it.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_IDS=
